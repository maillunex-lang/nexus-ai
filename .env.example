POSTGRES_PASSWORD=replace_with_long_random_password
NEXUS_MCP_INTERNAL_TOKEN=replace_with_random_48_plus_character_secret

# Optional Director schedule: advance approved pipelines every N seconds (15-3600). Unset = off.
# compose.yaml does not forward these two; add them to the api service environment (e.g. compose.override.yaml).
# NEXUS_DIRECTOR_TICK_SECONDS=60
# Days to keep finished Director records (default 30, 0 disables cleanup).
# NEXUS_DIRECTOR_RETENTION_DAYS=30
